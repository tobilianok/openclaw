# Pare-feu Proxmox de la VM 106 "majordome" (192.168.1.16).
# A copier dans /etc/pve/firewall/106.fw, puis activer le pare-feu sur la
# carte reseau de la VM (Materiel > net0 > Pare-feu) et dans Options.

[OPTIONS]
enable: 1
policy_in: DROP
policy_out: DROP

[RULES]
# --- Entrant ---
# Webhook Talk depuis Nextcloud
IN ACCEPT -source 192.168.1.12 -p tcp -dport 18789
# Hooks depuis n8n (briefing, bilan)
IN ACCEPT -source 192.168.1.14 -p tcp -dport 18789
# Metriques de l'anonymiseur pour Prometheus
IN ACCEPT -source 192.168.1.19 -p tcp -dport 8090
# Administration depuis ton PC (SSH + interface OpenClaw)
IN ACCEPT -source 192.168.1.29 -p tcp -dport 22
IN ACCEPT -source 192.168.1.29 -p tcp -dport 18789

# --- Sortant vers le LAN : seulement le necessaire ---
OUT ACCEPT -dest 192.168.1.1 -p udp -dport 53
OUT ACCEPT -dest 192.168.1.1 -p tcp -dport 53
# n8n (MCP) et NPM (Nextcloud via son nom de domaine)
OUT ACCEPT -dest 192.168.1.14 -p tcp -dport 5678
OUT ACCEPT -dest 192.168.1.14 -p tcp -dport 443
# Nextcloud en direct (si le nom resout vers .12)
OUT ACCEPT -dest 192.168.1.12 -p tcp -dport 443
# Tout le reste du reseau prive est interdit (Proxmox, iLO, Vaultwarden, PC...)
OUT DROP -dest 10.0.0.0/8
OUT DROP -dest 172.16.0.0/12
OUT DROP -dest 192.168.0.0/16

# --- Sortant vers Internet (API des IA gratuites, mises a jour) ---
OUT ACCEPT -p tcp -dport 443
OUT ACCEPT -p tcp -dport 80
OUT ACCEPT -p udp -dport 123
