// Configuration OpenClaw du majordome, sur la VM 106 "majordome" (192.168.1.16).
// Validee avec OpenClaw 2026.9.8. A appliquer avec `openclaw config patch`
// (voir README, etape 7), pas en copiant le fichier par-dessus.
//
// Les secrets ne sont jamais ecrits ici : ils viennent de ~/.openclaw/.env
// (voir .env.example) via la substitution ${VAR}.
//
// Principe : OpenClaw ne connait AUCUNE cle d'IA. Son seul "fournisseur" est
// l'anonymiseur local (127.0.0.1:8090), qui pseudonymise tout ce qui sort,
// choisit une IA cloud gratuite et retablit les vraies valeurs au retour.
{
  gateway: {
    mode: "local",
    port: 18789,
    // Ecoute sur le LAN : Nextcloud (.12) pousse le webhook Talk, n8n (.14)
    // appelle /hooks. Le pare-feu Proxmox de la VM filtre qui peut entrer.
    bind: "lan",
    auth: {
      mode: "token",
      token: "${OPENCLAW_GATEWAY_TOKEN}",
    },
  },

  models: {
    providers: {
      anonymiseur: {
        baseUrl: "http://127.0.0.1:8090/v1",
        apiKey: "${ANONYMISEUR_TOKEN}",
        api: "openai-completions",
        timeoutSeconds: 180,
        // Profils du routeur (voir anonymiseur/config.yaml). contextTokens :
        // les regles, outils et fiches de Jarvis pesent deja ~40k tokens ; a
        // 48k, une seule lecture SSH faisait deborder la session. 96k tient
        // chez les routes principales (NVIDIA 120k, Gemini 1M).
        models: [
          { id: "auto", name: "Majordome (IA gratuites anonymisees)", reasoning: false, input: ["text"], contextWindow: 120000, contextTokens: 96000, maxTokens: 8192 },
          { id: "reflexion", name: "Majordome - reflexion", reasoning: false, input: ["text"], contextWindow: 120000, contextTokens: 96000, maxTokens: 8192 },
          { id: "conseil", name: "Majordome - conseil de 3 IA", reasoning: false, input: ["text"], contextWindow: 120000, contextTokens: 96000, maxTokens: 8192 },
        ],
      },
    },
  },

  // Recherche dans la memoire par mots-cles uniquement : aucun calcul
  // d'"embeddings" n'est envoye a un service externe.
  memory: {
    search: {
      provider: "none",
    },
  },

  agents: {
    ownership: "explicit",
    defaults: {
      userTimezone: "Europe/Paris",
      systemAgent: { agentId: "majordome" },
      // Pas de heartbeat OpenClaw : c'est n8n qui rythme la journee
      // (briefing, bilan) et ca economise les quotas gratuits.
      heartbeat: { agentId: "majordome", every: "0m" },
    },
    entries: {
      majordome: {
        workspace: "~/.openclaw/workspace-majordome",
        model: {
          primary: "anonymiseur/auto",
          // La bascule entre IA gratuites est faite par l'anonymiseur.
          fallbacks: [],
        },
        tools: {
          profile: "coding",
          // - group:runtime : pas d'execution de commandes sur la VM
          // - browser, group:web : la navigation et la recherche web
          //   partiraient vers Internet SANS anonymisation
          deny: ["group:runtime", "browser", "group:web"],
        },
      },
    },
  },

  // Le salon Talk "Majordome". Le jeton du salon est la fin de son URL :
  // https://<nextcloud>/call/<jeton>. Remplacer JETON_SALON_MAJORDOME ici ET
  // dans channels.nextcloud-talk.rooms (les cles d'objet ne supportent pas
  // la substitution ${VAR}).
  bindings: [
    {
      agentId: "majordome",
      comment: "Salon Talk 'Majordome'",
      match: {
        channel: "nextcloud-talk",
        peer: { kind: "group", id: "JETON_SALON_MAJORDOME" },
      },
    },
  ],

  // Plugin externe (installe avec `openclaw plugins install`) : il doit etre
  // explicitement autorise, sinon le canal Talk ne demarre pas.
  plugins: {
    entries: {
      "nextcloud-talk": { enabled: true },
    },
  },

  channels: {
    "nextcloud-talk": {
      enabled: true,
      baseUrl: "${NEXTCLOUD_URL}",
      botSecret: "${NEXTCLOUD_TALK_BOT_SECRET}",
      legacyWebhook: false,
      webhookPath: "/nextcloud-talk-webhook",
      // Personne d'autre que toi : pas de DM, salon sur liste blanche, et seul
      // ton identifiant Nextcloud est accepte. Nextcloud envoie l'expediteur
      // sous la forme "users/<id>" : les deux formes sont listees.
      dmPolicy: "disabled",
      groupPolicy: "allowlist",
      groupAllowFrom: ["${NEXTCLOUD_USER_ID}", "users/${NEXTCLOUD_USER_ID}"],
      rooms: {
        "JETON_SALON_MAJORDOME": { requireMention: false },
      },
      markdown: { tables: "bullets" },
      // A activer seulement si NEXTCLOUD_URL resout vers une IP privee
      // (DNS local / hairpin). Voir README, etape 7.
      // network: { dangerouslyAllowPrivateNetwork: true },
    },
  },

  // Les "mains" du majordome : deux serveurs MCP exposes par n8n.
  // Les jetons Home Assistant, Paperless, Nextcloud... restent dans n8n.
  // Les resultats des outils repartent vers l'IA via l'anonymiseur.
  mcp: {
    servers: {
      "n8n-outils": {
        url: "${N8N_MCP_OUTILS_URL}",
        transport: "streamable-http",
        connectionTimeoutMs: 5000,
        requestTimeoutMs: 30000,
        headers: { Authorization: "Bearer ${N8N_MCP_TOKEN}" },
      },
      "n8n-sensible": {
        url: "${N8N_MCP_SENSIBLE_URL}",
        transport: "streamable-http",
        connectionTimeoutMs: 5000,
        requestTimeoutMs: 30000,
        headers: { Authorization: "Bearer ${N8N_MCP_TOKEN}" },
      },
    },
  },

  // Point d'entree HTTP pour que n8n declenche le majordome
  // (briefing du matin, bilan du soir...).
  hooks: {
    enabled: true,
    token: "${OPENCLAW_HOOKS_TOKEN}",
    path: "/hooks",
    allowedAgentIds: ["majordome"],
    allowRequestSessionKey: false,
  },
}
