# ~/.openclaw/.env sur la VM majordome (chmod 600). Ne jamais commiter.
# Aucune cle d'IA ici : elles sont uniquement dans l'anonymiseur.

# Generer avec : openssl rand -hex 32
OPENCLAW_GATEWAY_TOKEN=
OPENCLAW_HOOKS_TOKEN=

# Le meme que ANONYMISEUR_TOKEN dans /opt/stacks/anonymiseur/.env
ANONYMISEUR_TOKEN=

# Nextcloud Talk
NEXTCLOUD_URL=https://cloud.exemple.fr
# Secret partage du bot (le meme que dans la commande occ talk:bot:install)
NEXTCLOUD_TALK_BOT_SECRET=
# Ton identifiant Nextcloud (pas le nom affiche)
NEXTCLOUD_USER_ID=tobilianok

# Serveurs MCP exposes par n8n (VM Docker)
N8N_MCP_OUTILS_URL=http://192.168.1.14:5678/mcp/majordome-outils
N8N_MCP_SENSIBLE_URL=http://192.168.1.14:5678/mcp/majordome-sensible
# Le meme que N8N_MCP_TOKEN dans n8n/majordome.env
N8N_MCP_TOKEN=
