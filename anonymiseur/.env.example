# /opt/stacks/anonymiseur/.env (chmod 600). Ne jamais commiter.
# Les SEULES cles d'IA de toute l'installation : OpenClaw n'en a aucune.

# Jeton qu'OpenClaw utilise pour parler a l'anonymiseur : openssl rand -hex 32
ANONYMISEUR_TOKEN=

# Fournisseurs gratuits (laisser vide = desactive)
GEMINI_API_KEY=
MISTRAL_API_KEY=
NVIDIA_API_KEY=
GROQ_API_KEY=
GITHUB_MODELS_TOKEN=
OPENROUTER_API_KEY=
