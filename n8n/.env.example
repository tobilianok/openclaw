# /opt/stacks/n8n/.env (chmod 600). Ne jamais commiter.
POSTGRES_PASSWORD=
# Cle de chiffrement des identifiants n8n : openssl rand -hex 32
# A SAUVEGARDER (Vaultwarden) : sans elle, les identifiants sont perdus.
N8N_ENCRYPTION_KEY=
# URL d'acces a l'interface (via NPM, liste d'acces LAN/Tailscale)
N8N_HOST=n8n.louisrousseaux.fr
N8N_PROTOCOL=https
WEBHOOK_URL=https://n8n.louisrousseaux.fr/
