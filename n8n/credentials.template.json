[
  {
    "id": "majCredMcpBearer",
    "name": "Majordome - jeton MCP",
    "type": "httpBearerAuth",
    "data": { "token": "@@N8N_MCP_TOKEN@@" }
  },
  {
    "id": "majCredHomeAssist",
    "name": "Majordome - Home Assistant",
    "type": "httpHeaderAuth",
    "data": { "name": "Authorization", "value": "Bearer @@HA_TOKEN@@" }
  },
  {
    "id": "majCredNextcloud1",
    "name": "Majordome - Nextcloud",
    "type": "httpBasicAuth",
    "data": { "user": "@@NC_USER@@", "password": "@@NC_APP_PASSWORD@@" }
  },
  {
    "id": "majCredSeerrApi01",
    "name": "Majordome - Seerr",
    "type": "httpHeaderAuth",
    "data": { "name": "X-Api-Key", "value": "@@SEERR_API_KEY@@" }
  },
  {
    "id": "majCredPaperless1",
    "name": "Majordome - Paperless (lecture)",
    "type": "httpHeaderAuth",
    "data": { "name": "Authorization", "value": "Token @@PAPERLESS_TOKEN@@" }
  },
  {
    "id": "majCredOcHooks001",
    "name": "Majordome - hooks OpenClaw",
    "type": "httpBearerAuth",
    "data": { "token": "@@OPENCLAW_HOOKS_TOKEN@@" }
  },
  {
    "id": "majCredJarvisSsh1",
    "name": "Majordome - jarvis-ssh",
    "type": "httpHeaderAuth",
    "data": { "name": "Authorization", "value": "Bearer @@JARVIS_SSH_TOKEN@@" }
  }
]
