# Valeurs utilisees par installer.sh pour preparer les identifiants et les
# workflows n8n du majordome. Copier en majordome.env (chmod 600), remplir,
# lancer ./installer.sh, puis SUPPRIMER majordome.env (les secrets sont
# alors chiffres dans la base n8n).

# --- Adresses des services (LAN) ---
NEXTCLOUD_URL=https://nextcloud.famillerousseaux.fr
# Calendrier partage avec l'utilisateur "majordome" (voir docs/installation.md)
NC_CALENDAR_PATH=/remote.php/dav/calendars/tobilianok/personal/
HA_URL=http://192.168.1.21:8123
PROMETHEUS_URL=http://192.168.1.19:9090
ALERTMANAGER_URL=http://192.168.1.19:9093
SEERR_URL=http://192.168.1.14:5055
PAPERLESS_URL=http://192.168.1.14:8010
OPENCLAW_URL=http://192.168.1.16:18789
# Jeton du salon Talk "Majordome" (fin de l'URL du salon)
TALK_ROOM_MAJORDOME=
# Domicile, pour la meteo (2 decimales suffisent)
METEO_LAT=48.85
METEO_LON=2.35

# --- Secrets ---
# Partage avec OpenClaw (N8N_MCP_TOKEN dans ~/.openclaw/.env) : openssl rand -hex 32
N8N_MCP_TOKEN=
# Jeton longue duree d'un utilisateur HA "majordome" (non admin)
HA_TOKEN=
# Utilisateur Nextcloud "majordome" + mot de passe d'application
NC_USER=tobilianok
NC_APP_PASSWORD=
# Seerr : Parametres > General > Cle API
SEERR_API_KEY=
# Paperless : jeton d'un utilisateur en lecture seule
PAPERLESS_TOKEN=
# Le meme que JARVIS_SSH_TOKEN dans jarvis-ssh.env
JARVIS_SSH_TOKEN=
JARVIS_SSH_URL=http://jarvis-ssh:8001
# Le meme que OPENCLAW_HOOKS_TOKEN dans ~/.openclaw/.env
OPENCLAW_HOOKS_TOKEN=
